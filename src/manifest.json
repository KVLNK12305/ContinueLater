{
  "manifest_version": 3,
  "name": "ContinueLater — Learning Continuity",
  "short_name": "ContinueLater",
  "description": "Never lose your learning flow. Detects unfinished learning sessions across YouTube, Articles, GitHub, PDFs and brings them back intelligently.",
  "version": "1.0.0",
  "permissions": [
    "tabs",
    "storage",
    "alarms",
    "notifications",
    "contextMenus",
    "activeTab",
    "scripting"
  ],
  "action": {
    "default_popup": "src/popup/index.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "src/background/service-worker.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.google.com/search*",
        "https://www.youtube.com/watch*",
        "https://*.substack.com/*",
        "https://medium.com/*",
        "https://*.medium.com/*",
        "https://github.com/*",
        "https://dev.to/*",
        "https://hashnode.com/*",
        "https://*.hashnode.dev/*",
        "https://*.wikipedia.org/wiki/*",
        "https://docs.google.com/document/*",
        "file://*/*.pdf",
        "https://*/*.pdf"
      ],
      "js": ["src/content/content-script.ts"],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "open-dashboard": {
      "suggested_key": {
        "default": "Ctrl+Shift+L",
        "mac": "Command+Shift+L"
      },
      "description": "Open ContinueLater Dashboard"
    }
  }
}
